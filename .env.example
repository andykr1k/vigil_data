# Copy to .env and fill in. Never commit .env.

# Hugging Face token with access granted to facebook/sam-3d-body-dinov3
# (request access on the model page, then create a read token at
# https://huggingface.co/settings/tokens)
HF_TOKEN=

# Optional: override the config file used by `vigil run`
# VIGIL_CONFIG=configs/default.yaml

# Clarius probe certificate for the Solum SDK (from Clarius Cloud, OEM program)
CLARIUS_CERT=
